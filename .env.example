# ─────────────────────────────────────────────────────────────
# APISIX deployment ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# `.env` git'e COMMIT EDİLMEZ (bkz. .gitignore).
# Dokploy üzerinde bu değerleri Environment ekranına girin.
# ─────────────────────────────────────────────────────────────

# Image sürümleri (compose tarafından kullanılır)
APISIX_IMAGE_TAG=3.16.0-debian
DASHBOARD_IMAGE_TAG=3.0.1-alpine
ETCD_IMAGE_TAG=3.5.11

# APISIX Admin API anahtarı — VARSAYILANI MUTLAKA DEĞİŞTİRİN.
# Üretmek için: openssl rand -hex 16
APISIX_ADMIN_KEY=change-me-please-use-a-strong-random-key

# APISIX Dashboard giriş bilgileri ve JWT secret'ı
# (Dashboard public'e açılmamalı; yine de güçlü değerler kullanın.)
# JWT secret üretmek için: openssl rand -hex 32
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change-me-strong-password
DASHBOARD_JWT_SECRET=change-me-long-random-jwt-secret

# NOT: Port tanımlamayın. Port/domain yönlendirmesi Dokploy (Traefik)
# tarafında yapılır; compose'da `ports:` kullanılmaz.
